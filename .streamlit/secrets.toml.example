# Streamlit Community Cloud: add these values under Advanced settings -> Secrets.
# Never commit secrets.toml.

EMAIL_SMTP_HOST = "smtp.gmail.com"
EMAIL_SMTP_PORT = "587"
EMAIL_SMTP_USERNAME = "assistant@example.com"
EMAIL_SMTP_PASSWORD = "replace-with-gmail-app-password"
EMAIL_FROM_ADDRESS = "assistant@example.com"
EMAIL_SMTP_TLS = "true"

OPENAI_API_KEY = ""
ANTHROPIC_API_KEY = ""
ENCRYPTION_KEY = "replace-with-output-from-python-c-export-generated-key"

# Optional Twilio phone sign-in
TWILIO_ACCOUNT_SID = ""
TWILIO_AUTH_TOKEN = ""
TWILIO_FROM_NUMBER = ""
